# Copy to .env for local preview (npm run dev loads it); never commit .env.
# Set these as Azure App Service application settings for hosting.
OPENAI_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1/
MODEL_DEPLOYMENT=gpt-4.1-mini
# Azure alternative: https://RESOURCE.openai.azure.com/openai/v1/
# MODEL_DEPLOYMENT is your deployed vision-capable model name. Not a project URL.
# Optional: enable and test AI automatically on page load when a server key exists.
# Each page load makes a small connection-test request.
RFX_AUTO_CONNECT=false
